  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Source: frontend/src/style.css — .primary; resume/replay action, without the larger .play-button override.",
      "html": "<button class=\"ds-primary\">Reprendre</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:14px 24px;min-height:50px;color:#fff1dc;border:1px solid #e87659;background:#a93428;font:800 24px/1.1 \"Barlow Condensed\",sans-serif;text-transform:uppercase;letter-spacing:.03em;border-radius:0;box-shadow:inset 0 2px 0 #fca1853d,inset 0 -3px 0 #451b1480,0 6px 18px #090b0960;cursor:pointer;transition:background-color 150ms,border-color 150ms;}.ds-primary:hover{background:#c64734;border-color:#ffc09a}.ds-primary:focus-visible{outline:3px solid #f4c782;outline-offset:5px;}.ds-primary:active{box-shadow:inset 0 3px 6px #090b0980}.ds-primary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-utility,.ds-score-submit{transition:none}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Source: frontend/src/style.css — .secondary; return/restart action.",
      "html": "<button class=\"ds-secondary\">Retour à l’accueil</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:14px 24px;min-height:50px;color:#fff1dc;border:1px solid #e87659;background:#a93428;font:800 24px/1.1 \"Barlow Condensed\",sans-serif;text-transform:uppercase;letter-spacing:.03em;border-radius:0;box-shadow:inset 0 2px 0 #fca1853d,inset 0 -3px 0 #451b1480,0 6px 18px #090b0960;cursor:pointer;transition:background-color 150ms,border-color 150ms;background:#30362b;border-color:#7e8566;font-size:20px}.ds-secondary:hover{background:#444c39;border-color:#c3c99e}.ds-secondary:focus-visible{outline:3px solid #f4c782;outline-offset:5px;}.ds-secondary:active{box-shadow:inset 0 3px 6px #090b0980}.ds-secondary:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-utility,.ds-score-submit{transition:none}}"
    },
    {
      "name": "Utility action",
      "kind": "button",
      "refersTo": "button-utility",
      "description": "Source: frontend/src/style.css — .utility and button svg; fullscreen control in the top bar.",
      "html": "<button class=\"ds-utility\" aria-pressed=\"false\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6\"/></svg>Plein écran</button>",
      "css": ".ds-utility{display:inline-flex;gap:10px;align-items:center;justify-content:center;background:transparent;border:1px solid transparent;color:var(--ink,#e9e3d4);padding:9px 10px;font:600 16px Barlow,sans-serif;min-height:42px;border-radius:0;cursor:pointer;transition:background-color 150ms,border-color 150ms}.ds-utility svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;flex-shrink:0}.ds-utility:hover{color:#fff4de;background:#4c51393d;border-color:#9ba08466}.ds-utility:focus-visible{outline:3px solid #f4c782;outline-offset:5px;}.ds-utility:disabled{opacity:.45;cursor:default}@media(max-width:640px){.ds-utility{font-size:14px;gap:7px;padding:8px}}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-utility,.ds-score-submit{transition:none}}"
    },
    {
      "name": "Score field",
      "kind": "input",
      "refersTo": "score-field",
      "description": "Source: frontend/src/style.css — form label, .input-row and input; ScoreForm.jsx.",
      "html": "<label class=\"ds-field-label\" for=\"ds-player\">Pseudo</label><input class=\"ds-field\" id=\"ds-player\" name=\"player\" maxlength=\"24\" autocomplete=\"nickname\" required>",
      "css": ".ds-field-label{display:block;font:600 16px Barlow,sans-serif;color:var(--ink,#e9e3d4);margin-bottom:9px}.ds-field{min-width:0;padding:13px 14px;font:400 17px Barlow,sans-serif;border:1px solid #929978;color:#f0ebdc;background:#0f150d;border-radius:0;caret-color:#f8735d}.ds-field:focus-visible{outline:3px solid #f4c782;outline-offset:5px;}"
    },
    {
      "name": "Score submit",
      "kind": "button",
      "refersTo": "score-submit",
      "description": "Source: frontend/src/style.css — .input-row button; compact form action.",
      "html": "<button class=\"ds-score-submit\" type=\"submit\">Enregistrer le score</button>",
      "css": ".ds-score-submit{padding:12px 16px;background:#a93427;border:1px solid #ed8a6b;color:#fff1dc;font:600 16px Barlow,sans-serif;border-radius:0;cursor:pointer;transition:background-color 150ms,border-color 150ms}.ds-score-submit:hover{background:#c24633}.ds-score-submit:focus-visible{outline:3px solid #f4c782;outline-offset:5px;}.ds-score-submit:disabled{opacity:.45;cursor:default}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary,.ds-utility,.ds-score-submit{transition:none}}"
    },
    {
      "name": "Menu panel",
      "kind": "card",
      "refersTo": "menu-panel",
      "description": "Source: frontend/src/style.css — .menu-panel; pause/result container, with its real heading and paragraph.",
      "html": "<section class=\"ds-menu\"><h2>En pause</h2><p>Soufflez un instant. Le secteur peut attendre.</p></section>",
      "css": ".ds-menu{width:min(100%,580px);padding:30px 34px;background:#20251cef;color:var(--ink,#e9e3d4);border:1px solid #858b67;box-shadow:0 20px 70px #030603aa,inset 0 2px 0 #bdc49322;font-family:Barlow,sans-serif}.ds-menu>h2{font:800 clamp(46px,6vw,72px)/1 \"Barlow Condensed\",sans-serif;text-transform:uppercase;color:#f28669;margin:0 0 12px}.ds-menu>p{color:#d3d6c0;line-height:1.5;font-size:17px;margin:0 0 24px}@media(max-width:640px){.ds-menu{padding:24px 20px}.ds-menu>h2{font-size:48px}}"
    },
    {
      "name": "Player HUD",
      "kind": "custom",
      "refersTo": "player-hud",
      "description": "Source: frontend/src/style.css — .hud, .hud-cell, .health-cell, .weapon-cell and .mission-cell; Hud.jsx. Preview uses the real five cells and mobile reduction.",
      "html": "<footer class=\"ds-hud\" aria-label=\"État du joueur\"><div class=\"ds-hud-cell ds-weapon\"><span>Arme</span><strong>Pistolet</strong><small>Clic gauche / Espace</small></div><div class=\"ds-hud-cell\"><span>Munitions</span><strong aria-label=\"Illimitées\">∞</strong><small>Illimitées</small></div><div class=\"ds-hud-cell ds-health\"><label for=\"ds-health\">Vie</label><strong>3<small> / 3</small></strong><progress id=\"ds-health\" value=\"3\" max=\"3\"></progress></div><div class=\"ds-hud-cell\"><span>Ennemi</span><strong>2<small> PV</small></strong><small>Hostile</small></div><div class=\"ds-hud-cell ds-mission\"><span>Objectif</span><strong>La sortie</strong><small>Survivez. Explorez. Sortez.</small></div></footer>",
      "css": ".ds-hud{height:var(--hud-height,124px);display:grid;grid-template-columns:1.15fr .8fr 1.2fr .8fr 1.15fr;background:repeating-linear-gradient(0deg,#0000000a 0 1px,transparent 1px 4px),linear-gradient(#515344,#292d24 20%,#373d2d 90%,#1b2017);border-top:3px solid #888a71;box-shadow:0 -8px 32px #080a0870;font-family:Barlow,sans-serif}.ds-hud-cell{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;padding:10px 12px;border-right:1px solid #757a5866;min-width:0}.ds-hud-cell:last-child{border-right:0}.ds-hud-cell>span,.ds-hud-cell>label{text-transform:uppercase;font:800 17px/1 \"Barlow Condensed\",sans-serif;color:#d2d3ba;letter-spacing:.07em}.ds-hud-cell>strong{font:800 47px/.95 \"Barlow Condensed\",sans-serif;color:#f0d29c;text-shadow:1px 2px 1px #15190e;font-variant-numeric:tabular-nums}.ds-hud-cell>small{font-size:12px;color:#d5d6bc;line-height:1.3;text-align:center}.ds-hud-cell strong small{font-size:24px;color:#bdc5a6}.ds-weapon>strong,.ds-mission>strong{font-size:32px;text-transform:uppercase}.ds-health>strong{color:#ff8767}.ds-health progress{width:min(100%,128px);height:6px;border:none;background:#171d13;accent-color:#ed8060;margin-top:3px}.ds-health progress::-webkit-progress-bar{background:#171d13}.ds-health progress::-webkit-progress-value{background:#ed8060}.ds-health progress::-moz-progress-bar{background:#ed8060}@media(max-width:900px){.ds-hud-cell>strong{font-size:40px}.ds-weapon>strong,.ds-mission>strong{font-size:26px}}@media(max-width:640px){.ds-hud{height:104px;grid-template-columns:1fr 1fr 1fr}.ds-weapon,.ds-mission{display:none}.ds-hud-cell>strong{font-size:38px}.ds-hud-cell>span,.ds-hud-cell>label{font-size:16px}}"
    },
    {
      "name": "Keyboard hint",
      "kind": "custom",
      "description": "Source: frontend/src/style.css — .commands > span and kbd; command legend rather than an interactive chip.",
      "html": "<span class=\"ds-command\"><kbd>ZQSD</kbd> / <kbd>WASD</kbd> Marcher</span>",
      "css": ".ds-command{display:inline-flex;gap:7px;align-items:center;flex-wrap:wrap;color:#c0c5ae;font:400 14px/1.6 Barlow,sans-serif}.ds-command kbd{display:inline-block;padding:2px 5px;border:1px solid #7d8565;background:#22281d;color:#eee8d5;font:600 12px/1.3 Barlow,sans-serif;white-space:nowrap}"
    }
  ],
  "narrative": {
    "northStar": "Ambiance du jeu Doom — premier Doom (1993)",
    "overview": "« Ambiance du jeu Doom » est la direction confirmée : le premier Doom (1993) fournit le langage du FPS rétro. L’acier olive, le graphite, le rouge braise et les caractères condensés donnent aux menus et au HUD le même caractère que le secteur exploré.\n\nLe décor est pixelisé ; les commandes restent du texte HTML net. Les titres sont massifs, les surfaces carrées et les informations de jeu concentrées dans une barre basse. Le jeu occupe la fenêtre et propose le plein écran natif. Les menus de pause et de résultat se superposent au niveau en gardant le HUD visible.\n\nLes images du couloir et du pistolet sont des créations originales générées, avec provenance à côté des fichiers dans `frontend/public/art/`. Les textures industrielles du niveau sont produites dans le projet. Cette direction ne fournit aucune autorisation de reprendre les assets originaux de Doom.",
    "keyCharacteristics": [
      "Acier olive et graphite, accents rouge braise, réussite et sortie vertes.",
      "Titres Barlow Condensed lourds ; texte courant Barlow lisible.",
      "Angles droits, filets et biseaux sombres, profondeur industrielle.",
      "Canvas pleine fenêtre, HUD bas et menus superposés.",
      "Art pixelisé original ; focus clavier visible et mouvement réduit respecté."
    ],
    "rules": [
      {
        "name": "The Mission Color Rule",
        "body": "Le vert signale la sortie et la réussite ; le rouge porte les actions, les menaces et la perte de vie. Le libellé complète toujours le code couleur.",
        "section": "colors"
      },
      {
        "name": "The Live View Rule",
        "body": "En jeu, la vue remplit l’espace au-dessus du HUD ; pause et résultat se placent devant elle sans masquer la barre d’état.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do conserver les deux familles Barlow auto-hébergées et leur licence OFL.",
      "Do garder la hiérarchie entre action principale rouge, action secondaire olive et commande utilitaire transparente.",
      "Do conserver le focus visible, les messages textuels, les états désactivés et le respect de prefers-reduced-motion.",
      "Do préserver les pixels de la vue et de l’arme avec image-rendering: pixelated.",
      "Do accompagner chaque nouvel asset raster livré de sa provenance."
    ],
    "donts": [
      "Don’t remplacer les surfaces carrées par des pilules ou des cartes arrondies.",
      "Don’t étendre la palette vers le néon bleu ou violet du cyberpunk moderne.",
      "Don’t copier de sprites, textures ou logos du Doom original.",
      "Don’t transformer le HUD et les messages de jeu en éléments purement décoratifs."
    ]
  }
